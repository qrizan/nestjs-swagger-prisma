# Allowlist: semua diabaikan lebih dulu, lalu hanya yang dibutuhkan build yang dibuka kembali.
# File baru karena itu tidak ikut ke image kecuali ditambahkan di bawah.
*

!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!nest-cli.json
!tsconfig.json
!tsconfig.build.json
!src
!prisma
!public

# Dikecualikan lagi dari direktori yang sudah dibuka di atas.
# Spec ikut ter-copy kalau tidak disebut, meski tsconfig.build.json tidak mengompilasinya.
src/**/*.spec.ts

# Seed hanya dipakai saat pengembangan dan bergantung pada dev dependency.
prisma/seed.ts

# Sudah tertutup oleh `*`, ditulis ulang eksplisit karena dampaknya paling besar:
# @prisma/client memuat .env relatif terhadap prisma/schema.prisma, bukan cwd,
# sehingga .env yang ikut ke image akan menimpa env yang di-inject saat runtime.
.env
.env.*
prisma/.env
