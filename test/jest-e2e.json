{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1"
  },
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "^.+\\.js$": [
      "babel-jest",
      {
        "presets": [["@babel/preset-env", { "targets": { "node": "current" } }]]
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/\\.pnpm/(?!(dom-serializer|domelementtype|domhandler|domutils|entities|htmlparser2|nanoid)@)"
  ]
}
